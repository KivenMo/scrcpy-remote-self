# 复制为 .env，然后按需修改
# cp deploy/.env.example deploy/.env

# ── 端口 ──
HTTP_PORT=8080
TCP_PORT=8081

# ── TLS（被控端直接连的端口用）──
# 有域名 + Let's Encrypt：不用填（Caddy 终止 TLS，中继跑明文 HTTP）
# 无域名 + 自签证书：
#   TLS_CERT=/app/certs/cert.pem
#   TLS_KEY=/app/certs/key.pem
TLS_CERT=
TLS_KEY=

# ── 安全 ──
# /health 的令牌。不设的话启动日志会打警告，公网部署必须设。
HEALTH_TOKEN=换一个随机串，比如 openssl rand -base64 32

# 前面挂了 Caddy 反代就设 1，否则别设（伪造 XFF 能绕过限流）
TRUST_PROXY=1

# 猜配对码限流（默认就够，一般不用改）
RATE_LIMIT_DISTINCT=6
RATE_LIMIT_TRIES=80
RATE_LIMIT_WINDOW_MS=300000
RATE_LIMIT_BLOCK_MS=600000
